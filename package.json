{
  "name": "ce-beads",
  "version": "0.1.0",
  "type": "module",
  "description": "OMP-native bridge that imports Compound Engineering implementation-ready plans into a Beads dependency graph.",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/sh1ny/ce-beads.git"
  },
  "homepage": "https://github.com/sh1ny/ce-beads",
  "bugs": {
    "url": "https://github.com/sh1ny/ce-beads/issues"
  },
  "packageManager": "bun@1.3.14",
  "bin": {
    "ce-beads": "skills/ce-beads/scripts/cli.ts"
  },
  "files": [
    "skills/",
    "agents/",
    "README.md",
    "UPSTREAMS.lock.json"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "os": ["linux"],
  "keywords": [
    "omp-plugin",
    "agent-skill",
    "compound-engineering",
    "beads"
  ],
  "omp": {
    "name": "ce-beads",
    "description": "Bridge Compound Engineering implementation-ready plans into Beads dependency graphs."
  },
  "scripts": {
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
